<script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
<script>
(function ($) {
    var projectTurnstileWidget = null;
    var projectTurnstilePending = false;
    var projectTurnstileSiteKey = '0x4AAAAAAEadQP2KTToF-fUm';

    function setProjectTurnstilePending(pending) {
        projectTurnstilePending = pending;
        $('.project-turnstile-send').toggleClass('disabled', pending).attr('aria-disabled', pending ? 'true' : 'false');
    }

    function showProjectTurnstileError(message) {
        var error = $('#add-project-form .turnstile-error');
        error.text(message || 'Не удалось пройти проверку. Повторите попытку.').show();
        setProjectTurnstilePending(false);
    }

    function sendProjectTurnstileForm(token) {
        var form = $('#add-project-form');
        form.find('input[name="cf-turnstile-response"]').remove();
        $('<input>', {type: 'hidden', name: 'cf-turnstile-response', value: token}).appendTo(form);

        $.ajax({
            contentType: false,
            processData: false,
            type: 'POST',
            url: '/local/ajax/add_project_form.php',
            data: new FormData(form.get(0))
        }).done(function (data) {
            try {
                data = typeof data === 'string' ? JSON.parse(data) : data;
            } catch (error) {
                data = {status: '0', message: 'Некорректный ответ сервера'};
            }

            if (String(data.status) === '1') {
                $('#project_form_result').modal();
                form.find('input[id^=form_text_], textarea[name=description]').val('');
            } else {
                showProjectTurnstileError(data.message || 'Заявка не отправлена. Повторите попытку.');
            }
        }).fail(function () {
            showProjectTurnstileError('Сервер временно недоступен. Повторите попытку.');
        }).always(function () {
            setProjectTurnstilePending(false);
            if (window.turnstile && projectTurnstileWidget !== null) {
                window.turnstile.reset(projectTurnstileWidget);
            }
        });
    }

    function executeProjectTurnstile(attempt) {
        attempt = attempt || 0;
        if (!window.turnstile) {
            if (attempt < 20) {
                window.setTimeout(function () { executeProjectTurnstile(attempt + 1); }, 250);
            } else {
                showProjectTurnstileError('Проверка защиты не загрузилась. Обновите страницу и повторите попытку.');
            }
            return;
        }

        if (projectTurnstileWidget === null) {
            projectTurnstileWidget = window.turnstile.render('#project-turnstile', {
                sitekey: projectTurnstileSiteKey,
                size: 'invisible',
                execution: 'execute',
                callback: sendProjectTurnstileForm,
                'error-callback': function () { showProjectTurnstileError(); },
                'expired-callback': function () { setProjectTurnstilePending(false); }
            });
        }
        window.turnstile.execute(projectTurnstileWidget);
    }

    $(document).on('click', '.project-turnstile-send', function (event) {
        event.preventDefault();
        if (projectTurnstilePending) {
            return false;
        }

        var form = $('#add-project-form').get(0);
        $('#add-project-form .turnstile-error').hide();
        if (!form.checkValidity()) {
            form.reportValidity();
            return false;
        }
        if (!$('#add-project-form input[name=privacy]').is(':checked')) {
            $('#add-project-form input[name=privacy]').siblings('.error-fld').show();
            return false;
        }

        setProjectTurnstilePending(true);
        executeProjectTurnstile(0);
        return false;
    });
})(jQuery);
</script>
<?endif;?>

